#----------------------------------#
# Stripe (payments). Copy this file to .env and paste your own test keys.
STRIPE_SECRET_KEY=paste_your_stripe_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=paste_your_stripe_publishable_key_here

# Laravel CMS API (optional)
# Leave this out in development: the Vite dev server proxies /api to Laravel on port 8000.
# Set it only when the API is hosted on a different address.
# VITE_API_BASE_URL=https://cms.example.org/api
# VITE_ASSET_BASE_URL=https://cms.example.org
